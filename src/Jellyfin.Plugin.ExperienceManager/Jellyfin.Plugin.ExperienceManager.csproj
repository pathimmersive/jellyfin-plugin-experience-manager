<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ExperienceManager</RootNamespace>
    <Version>0.1.0.0</Version>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The plugin ABI the build declares; Jellyfin refuses to load a plugin whose targetAbi is newer than the server. -->
    <JellyfinTargetAbi>12.0.0.0</JellyfinTargetAbi>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host provides these at runtime; ExcludeAssets keeps them out of the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <!-- Jellyfin ships SQLite (Microsoft.Data.Sqlite.Core and e_sqlite3) for its own database; the plugin uses the host's copy. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.ExperienceManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The admin page, served by Jellyfin from the plugin assembly. -->
    <EmbeddedResource Include="Web\admin.html" />
    <!-- The home client, which jellyfin-web loads from /ExperienceManager/home.js and home.css. -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\home\home.js" LogicalName="home.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\home\home.css" LogicalName="home.css" />
    <!-- The admin page's Programming script, which admin.html loads from /ExperienceManager/admin-programming.js. -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\admin\programming.js" LogicalName="admin-programming.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\admin\audiences.js" LogicalName="admin-audiences.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\admin\layout.js" LogicalName="admin-layout.js" />
  </ItemGroup>

  <!-- The plugin image: Dashboard → Plugins shows it from the plugin folder (meta.json's imagePath), and the
       plugin repository's manifest points the catalog at the same file in the repository (imageUrl). -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\images\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- meta.json is the plugin manifest Jellyfin reads from the plugin folder. -->
  <Target Name="WritePluginMeta" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_PluginMetaPath>$(IntermediateOutputPath)meta.json</_PluginMetaPath>
      <_PluginMetaJson>{
  "category": "General",
  "description": "Server-side control over what every user sees on the Jellyfin home screen.",
  "guid": "49cf9109-2fbf-4d2e-9eb7-6def4f1efb1e",
  "imagePath": "icon.png",
  "imageUrl": "https://raw.githubusercontent.com/pathimmersive/jellyfin-plugin-experience-manager/main/images/icon.png",
  "name": "Experience Manager",
  "overview": "Programme the home screen for your users from one admin page.",
  "owner": "experience-manager",
  "targetAbi": "$(JellyfinTargetAbi)",
  "version": "$(Version)"
}</_PluginMetaJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PluginMetaPath)" Lines="$(_PluginMetaJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_PluginMetaPath)" Link="meta.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="$(_PluginMetaPath)" />
    </ItemGroup>
  </Target>

</Project>
